{
  "name": "ai-sre-demo-app",
  "version": "1.0.0",
  "type": "module",
  "description": "Target microservice demo app for AI-SRE incident diagnosis",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node --input-type=module -e \"import fs from 'fs'; fs.cpSync('src/static', 'dist/static', {recursive: true})\"",
    "start": "node dist/index.js",
    "test:incidents": "tsx src/scripts/test-incidents.ts",
    "traffic": "tsx src/scripts/traffic-generator.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
