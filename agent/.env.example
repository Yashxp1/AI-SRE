# AI-SRE Agent Configuration
AGENT_PORT=4242
TARGET_SERVICE_URL=http://localhost:8000
ADMIN_API_KEY=sre-demo-secret-key-2026

# Required only to authorize API-driven auto-remediation. Use a strong value outside this demo.
AGENT_API_KEY=replace-with-a-strong-agent-api-key

# Google Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Maximum tool-call iterations before synthesizing final RCA
MAX_INVESTIGATION_TURNS=8

# Per-call timeout for target-service diagnostic tools.
REQUEST_TIMEOUT_MS=5000

